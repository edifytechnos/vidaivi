# Copy to .env.local for local development (.env.local is gitignored).

# Enables the login screens. Without it the app is guest-only.
# This is the public Google OAuth client id — safe to commit, but note that
# Google sign-in itself only works from origins registered on the OAuth client;
# student and admin logins work on localhost regardless.
VITE_GOOGLE_CLIENT_ID=722814845567-paa2htbssu4erndaahb8b284q3966o4a.apps.googleusercontent.com

# Where `npm run dev` sends /api/* calls. Defaults to production.
# Point it at a PR preview to test against unmerged API changes.
#VITE_API_TARGET=https://vidaivi.seyali.app
